{
	"id": "knowledge-graph",
	"name": "知识图谱",
	"builtin": true,
	"version": "1.3.0",
	"description": "把笔记之间的关联（双链、插入的笔记链接、相同的标签）画成一张图：点一个节点看它连着什么，双击打开。启用后，主侧栏会出现「图谱」入口，笔记的「更多」菜单里可以「在图谱中查看」。",
	"author": {
		"name": "Flota 团队",
		"email": "team@Flota.app",
		"url": "https://github.com/Xperiamol"
	},
	"homepage": "https://github.com/Xperiamol",
	"repository": "https://github.com/Xperiamol/Flota",
	"license": "MIT",
	"categories": [
		"视图",
		"知识管理"
	],
	"tags": [
		"graph",
		"links",
		"visualization"
	],
	"icon": "icon.svg",
	"entry": "index.js",
	"permissions": {
		"notes:read": true
	},
	"runtime": {
		"type": "worker",
		"timeout": 10000
	},
	"capabilities": {
		"views": [
			{
				"id": "knowledge-graph.main",
				"title": "图谱",
				"tooltip": "知识图谱",
				"icon": "Hub",
				"surface": "main:view",
				"viewModule": "view/index.js",
				"navId": "graph"
			}
		]
	},
	"minAppVersion": "2.0.0"
}
